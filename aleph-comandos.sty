\newcounter{problemaCounter}

\newtcolorbox{problema}[1]{
    before={
        \stepcounter{problemaCounter}
        \ifnum\value{problemaCounter}>1
            \clearpage
        \fi
    },
    colback=gray!15,
    colframe=colortext,
    coltitle=white, 
    fonttitle=\bfseries\large, 
    title={#1}, 
    boxrule=0.8pt, 
    breakable,
    pad at break*=2mm,
    bottom=0mm 
}

\newtcolorbox{desarrollo}{
    colback=white,
    colframe=colortext!80!black,
    title=\textbf{Desarrollo},
    fonttitle=\bfseries\small,
    coltitle=white,
    boxrule=0.5pt,
    left=3mm, right=3mm, top=3mm, bottom=3mm,
    sharp corners=north,
    enhanced,
    breakable,
    before skip=0pt,
    attach boxed title to top left={yshift=-2mm, xshift=2mm},
    boxed title style={colback=colortext!80!black}
}

\newtcolorbox{formulario}[1]{
    colback=white,
    colframe=gray!40,
    title=\textbf{#1},
    fonttitle=\bfseries,
    coltitle=black,
    boxrule=0.5pt,
    sharp corners,
    enhanced
}
